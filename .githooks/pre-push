#!/bin/sh
# Holdexar 推送门禁 —— pre-push（配置：git config core.hooksPath .githooks）
#
# 快速全树敏感面与注释留痕扫描（秒级），全量测试归云端 CI 手动触发。

echo "[pre-push] 敏感面检查（凭据 / 大文件 / 用户数据）..."
if ! python scripts/check_secrets.py --all; then
  echo "✗ 敏感面检查未通过，推送止步。" >&2
  exit 1
fi
echo "[pre-push] ✓ 通过"

echo "[pre-push] 注释留痕全树检查（禁止开发过程 / 内部文档引用 / 外部溯源）..."
if ! python scripts/check_dev_traces.py --all; then
  echo "✗ 注释留痕全树检查未通过，推送止步。" >&2
  exit 1
fi
echo "[pre-push] ✓ 通过"

echo "[pre-push] 共同作者尾注检查（阻止外部工具署名进 Contributors）..."
if git log --format='%B' | grep -qi '^[[:space:]]*co-authored-by:'; then
  echo "✗ 待推送提交含共同作者尾注，推送止步。" >&2
  git log --format='%h %s' | head -20 >&2
  exit 1
fi
echo "[pre-push] ✓ 通过"
