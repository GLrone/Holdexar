mail.ini
secrets/

# ── 编辑器 / 系统 ──
.idea/
.vscode/
Thumbs.db
.DS_Store
desktop.ini
~$*
*.bak
*.orig
*.swp
*.tmp

# ── 调试转储 ──
# 锚定规则：模式中间出现 `/` 即锚定到本文件所在目录（仓库根），
# 故 `scripts/x.py` 只匹配根目录的 scripts/，**不**匹配 server/scripts/。
# 一次性的调试脚本实际落在 server/scripts/，因此两个位置都要列。
scripts/_report_*.json
server/scripts/_report_*.json
scripts/_history_*.html
server/scripts/_history_*.html
# 价格历史抓取的一次性对拍转储，落在仓库根（如 history-now.json）
/history-*.json

# ── 一次性临时脚本与产物（_tmp_* / _gen_* 前缀，本机专用，不上传）──
# 覆盖根目录散落的 _tmp_*.out/.err/临时目录，与 server/scripts/ 下的
# _tmp_*.py 探测脚本、_gen_*.py 一次性生成器。
/_tmp_*
/_gen_*
server/scripts/_tmp_*
server/scripts/_gen_*

# ── 一次性开发脚本（本机调试/基准/验证用，不上传）──
# 刻意不写 `**/scripts/`：那会连 web/scripts/check-routes.mjs（构建门禁必需）一起扫掉。
scripts/bench_*.py
server/scripts/bench_*.py
scripts/debug_*.cjs
server/scripts/debug_*.cjs
scripts/seed_*.py
server/scripts/seed_*.py
scripts/shot_*.cjs
server/scripts/shot_*.cjs
scripts/verify_*.cjs
server/scripts/verify_*.cjs
scripts/verify_*.py
server/scripts/verify_*.py
scripts/import_*.py
server/scripts/import_*.py
dy-tour-e2e/

# ── 外部平台爬虫 / 本机一次性诊断脚本 ──
# 共同特征：含第三方平台签名协议实现，或硬编码本机专属绝对路径。
# 入库后对任何其他 clone 都是坏引用。通配须宽于「下划线形态」（窄模式
# 要求紧跟下划线，会漏掉数字/前缀变体）；带前缀的文件名不匹配通配，单独列出。
server/scripts/hey*box*
server/scripts/probe_recover.py
server/scripts/test_hey*box*.py

# ── 隔离验证数据目录（本会话/历史会话的迁移演练与爬虫验证临时库，绝不入库）──
server/_tmp_*/
server/_tmp_verify_data/

# ── 本会话临时/调研残留（不入库）──
/_tmp_close_smoke/
/holdexar-dev/
